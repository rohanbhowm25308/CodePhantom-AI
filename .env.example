# Paste your key from https://console.groq.com/keys (no quotes, no spaces)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b   # optional; default already works

# ── optional ──
APP_ENV=development
# Code execution: Docker is auto-detected. Or use Judge0:
# JUDGE0_URL=https://your-judge0-host
# JUDGE0_TOKEN=
RUN_TIMEOUT=5
RUN_MEMORY=512m
RUN_CONCURRENCY=2
# Limits per IP
AI_PER_MIN=20
AI_PER_DAY=300
RUN_PER_MIN=20
RUN_PER_DAY=400
# Production: shared limits across workers, proxy trust, metrics
# REDIS_URL=redis://localhost:6379/0
# TRUST_PROXY=1
# METRICS_TOKEN=choose-a-long-random-string
